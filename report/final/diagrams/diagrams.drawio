  <diagram id="qQ4BmEsqjjW8-KyM4zbH" name="bootstrapping">
    <mxGraphModel dx="1647" dy="886" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="6v-apbp8qtS_2VE6CAmE-3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="1. Start with the saved request times&#xa;Use successful repetitions (at most 30 in this benchmark) of one query and configuration.&#xa;Exclude the warm-up." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="177" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="2. Randomly select values from the saved request times.&#xa;Keep the same number of values as the original list.&#xa;A recorded time can be selected more than once." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="298" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-5" edge="1" parent="1" source="6v-apbp8qtS_2VE6CAmE-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="6v-apbp8qtS_2VE6CAmE-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="3. Calculate the sample average&#xa;Add the sampled times and divide by their count." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="419" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-7" edge="1" parent="1" source="6v-apbp8qtS_2VE6CAmE-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="6v-apbp8qtS_2VE6CAmE-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="4. Repeat steps 2 and 3&#xa;Always draw from the original list.&#xa;Continue until you have 10,000 sample averages." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="540" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-9" edge="1" parent="1" source="6v-apbp8qtS_2VE6CAmE-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="6v-apbp8qtS_2VE6CAmE-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="5. Sort the 10,000 averages&#xa;Arrange them from smallest to largest." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="661" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-11" edge="1" parent="1" source="6v-apbp8qtS_2VE6CAmE-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="6v-apbp8qtS_2VE6CAmE-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-12" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="6. Find the interval endpoints&#xa;Use the 2.5th and 97.5th percentiles.&#xa;These form the 95% confidence interval." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="782" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-13" edge="1" parent="1" source="6v-apbp8qtS_2VE6CAmE-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="6v-apbp8qtS_2VE6CAmE-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6v-apbp8qtS_2VE6CAmE-14" parent="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#172B3A;fontSize=19;fontStyle=1;" value="The interval describes uncertainty in the average latency.&#xa;It is not the range containing 95% of individual request times." vertex="1">
          <mxGeometry height="95" width="677" x="75" y="898" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="we1l791vMRGjdxo5i_0z" name="bootstraping-configuration-comparison">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1K1sS0awpCEqz0o1TgzP-3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="1. Find queries tested in both A and B&#xa;For example: the same queries under two filter orders,&#xa;with the same layout and routing.&#xa;The length of this list is n." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="177" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="2. For each shared query, calculate its average latency separately in A and B using successful repeated requests. Then calculate one difference: average in B minus average in A." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="298" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-5" edge="1" parent="1" source="1K1sS0awpCEqz0o1TgzP-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="1K1sS0awpCEqz0o1TgzP-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="3. Collect the n query differences. &#xa;Illustrative example: +3, +2, +4 ms, giving n = 3." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="419" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-7" edge="1" parent="1" source="1K1sS0awpCEqz0o1TgzP-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="1K1sS0awpCEqz0o1TgzP-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#172B3A;fillColor=#F1F5F9;strokeColor=#64748B;spacing=12;" value="4. Randomly select n values from the list of query differences and calculate their average. A difference can be selected more than once." vertex="1">
          <mxGeometry height="96" width="647" x="90" y="540" as="geometry" />
        </mxCell>
        <mxCell id="1K1sS0awpCEqz0o1TgzP-9" edge="1" parent="1" source="1K1sS0awpCEqz0o1TgzP-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontSize=19;" target="1K1sS0awpCEqz0o1TgzP-8">
